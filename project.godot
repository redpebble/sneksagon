config_version=5

[application]

config/name="sneksagon"
config/tags=PackedStringArray("collab", "jasper")
run/main_scene="uid://diuykrg1nilh"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/icon="uid://cg8gu88o1w6my"

[autoload]

MapManager="*res://scenes/singleton/map_manager.gd"
Highlighter="*res://scenes/singleton/highlighter.tscn"
GameManager="*res://scenes/singleton/game_manager.tscn"
ModifierManager="*res://scenes/singleton/modifier_manager.tscn"

[display]

